PORT=3100
NODE_ENV=development

# MySQL — same instance/database RyderCup uses
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Which RyderCup event/year bets are booked against (RyderEvents.GroupID / RyderSession.RyderYear
# in the shared database). Bump RYDER_YEAR each year instead of changing code.
RYDER_GROUP_ID=1
RYDER_YEAR=2026

# Comma-separated emails allowed to approve/reject sign-ups at /admin/approvals
ADMIN_EMAILS=

# Session cookie signing — generate with: openssl rand -hex 32
JWT_SECRET=
SESSION_TTL_DAYS=30

# Magic-link email
APP_BASE_URL=https://bets.myclubgolf.com
MAGIC_LINK_TTL_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="RyderCup Bets <bets@myclubgolf.com>"
